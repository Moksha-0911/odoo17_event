<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_attendee_details">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="attendee">
                <div class="page">
                    <h2 style="text-align: center;">Event Attendee Details</h2>
                    <p><strong>Attendee Code:</strong> <t t-esc="attendee.attendee_event_code"/></p>
                    <p><strong>Name:</strong> <t t-esc="attendee.name"/></p>
                    <p><strong>Email:</strong> <t t-esc="attendee.email"/></p>
                    <p><strong>Phone:</strong> <t t-esc="attendee.phone"/></p>
                    <p><strong>Event:</strong> <t t-esc="attendee.event_id.name"/></p>
                    <div class="page">
                        <div t-options="{'widget': 'barcode', 'width': 600, 'height': 120, 'img_style': 'max-height:50pt;max-width:100%;', 'img_align': 'center'}" data-oe-demo="12345678901"/>
                        <h2 t-field="attendee.event_id.name"/>
                        <p>From <h2><span t-field="attendee.event_id.name"/></h2></p>

                        <h3>Attendees</h3>
                        <ul>
                            <t t-foreach="attendee.event_id.attendee_ids" t-as="event_attendee">
                                <li><span t-field="event_attendee.name"/></li>
                            </t>
                        </ul>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
