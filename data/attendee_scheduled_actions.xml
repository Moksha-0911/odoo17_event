<odoo>
    <record id="scheduled_action_send_attendee_emails" model="ir.cron">
        <field name="name">Send Attendee Registration Emails</field>
        <field name="model_id" ref="model_event_attendee"/>
        <field name="state">code</field>
        <field name="code">model._send_registration_emails()</field>
        <field name="interval_type">minutes</field>
        <field name="interval_number">5</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
