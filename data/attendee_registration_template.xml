<odoo>
    <template id="attendee_registration_template" name="Attendee Registration">
        <t t-call="website.layout">
            <div class="container mt-5">
                <h2 class="text-center">Attendee Registration Form</h2>

                <!-- Success Message -->
                <t t-if="success">
                    <div class="alert text-center p-3 rounded shadow-lg" style="background-color: #D8BFD8; color: black;">
                        <h3 class="text-white bg-success p-2 rounded">🎉 <t t-esc="success"/> 🎉</h3>
                    </div>
                </t>

                <t t-if="error">
                    <div class="alert alert-danger">
                        <t t-esc="error"/>
                    </div>
                </t>

                <form action="/attendee/submit" method="post" class="p-4 border rounded shadow">
                    <!-- CSRF Token -->
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="mb-3">
                        <label class="form-label">Attendee Name</label>
                        <input type="text" name="name" class="form-control" required="required"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="text" name="email" class="form-control" required="required"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="phone" class="form-control" required="required"/>
                    </div>
                     <div class="mb-3">
                        <label class="form-label">Select Event</label>
                        <select name="event_id" class="form-control" required="required">
                        <option value="">-- Choose Event --</option>
                        <t t-foreach="events" t-as="event">
                        <option t-att-value="event.id" t-att-selected="True if selected_event and event.id == selected_event.id else False"><t t-esc="event.name"/></option>
                        </t>
                    </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Select Ticket Type</label>
                        <select name="ticket_type_id" class="form-control" id="ticket_type">
                            <option value="">-- Choose Ticket Type --</option>
                            <t t-foreach="ticket_types" t-as="ticket">
                            <option t-att-value="ticket.id" t-att-selected="True if selected_ticket and ticket.id == selected_ticket.id else False">
                            <t t-esc="ticket.name"/> - <t t-esc="ticket.price"/> USD
                            </option>
                            </t>
                        </select>
                    </div>
                    <!--Providing ticket price details for the attendee registration-->
                    <t t-if="ticket_types">
                        <div class="mb-3">
                            <strong>Ticket Price:</strong> <span id="ticket_price"><t t-esc="ticket_price"/> USD</span>
                        </div>
                    </t>
                    <t t-else="">
                        <p class="text-muted">No ticket pricing available.</p>
                    </t>

                    <button type="submit" class="btn btn-primary">Register</button>
                </form>
            </div>
        </t>
    </template>
</odoo>