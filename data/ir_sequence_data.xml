<odoo>
    <data noupdate="0">
        <record id="seq_event_attendee" model="ir.sequence">
            <field name="name">Attendee Event Sequence</field>
            <field name="code">event.attendee.sequence</field>
            <field name="prefix">ATN/2025/</field>  <!-- Prefix for the sequence -->
            <field name="padding">3</field>  <!-- Ensures at least 3-digit numbering -->
            <field name="number_next">1</field>  <!-- Start sequence from 001 -->
            <field name="number_increment">1</field>  <!-- Increment by 1 -->
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
