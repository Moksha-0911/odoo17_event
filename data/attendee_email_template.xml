<odoo>
    <data noupdate="0">
        <!-- Email Template for Attendee Registration Confirmation -->
        <record id="email_template_attendee_confirmation" model="mail.template">
            <field name="name">Attendee Registration Confirmation</field>
            <field name="model_id" ref="Event_management.model_event_attendee"/>
            <field name="email_from">"mokshas206@gmail.com"</field>
            <field name="email_to">{{ (object.email) }}</field>
            <field name="subject">Registration Confirmation for {{ object.event_id.name }}</field>
            <field name="body_html">
                <![CDATA[
                    <p>Hello <t t-esc="object.name"/>,</p>
                    <p>Congratulations! You have successfully registered for the event:</p>
                    <p><strong><t t-esc="object.event_id.name"/></strong></p>
                    <p><strong>Date:</strong> <t t-esc="object.event_id.event_date"/></p>
                    <p>We look forward to your participation.</p>
                    <p>Best Regards,</p>
                    <p>Your Event Management Team</p>
                ]]>
            </field>
        </record>
    </data>
</odoo>
