<odoo>
    <template id="event_dashboard_template">
        <t t-call="web.layout">
            <div class="dashboard-container">
                <h1 class="dashboard-title">📊 Event Management Dashboard</h1>

                <!-- Statistics Section -->
                <div class="stats-container">
                    <div class="stat-box">
<!--                        <a t-attf-href="/web#action=89">-->
                            <i class="fa fa-calendar-check"></i>
                            Total Events
                            <span><t t-esc="total_events"/></span>

                    </div>
                    <div class="stat-box">
<!--                        <a t-attf-href="/web#action=254">-->
                            <i class="fa fa-users"></i>
                            Total Attendees
                            <span><t t-esc="total_attendees"/></span>
                    </div>
                </div>

                <!-- Recent Events Section -->
                <h3 class="section-title">📅 Recent Events</h3>
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Date</th>
                            <th>Attendees</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="events" t-as="event">
                            <tr>
                                <td><t t-esc="event['name']"/></td>
                                <td><t t-esc="event['event_date']"/></td>
                                <td><t t-esc="event['attendee_count']"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>

        <style>
            /* General Page Styling */
            .dashboard-container {
                padding: 20px;
                background: #f1f1f1;
                font-family: "Poppins", sans-serif;
            }
            .dashboard-title {
                font-size: 40px;
                text-align: center;
                font-weight: extra-bold;
                color: #333;
                margin-bottom: 20px;
                text-transform: uppercase;
            }

            /* Statistics Boxes */
            .stats-container {
                display: flex;
                gap: 20px;
                justify-content: center;
                margin-bottom: 20px;
            }
            .stat-box {
                background: linear-gradient(135deg, #007bff, #00c6ff);
                padding: 30px;
                border-radius: 13px;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
                text-align: center;
                font-size: 20px;
                font-weight: bold;
                color: white;
                flex: 1;
                transition: transform 0.3s ease-in-out;
                max-width: 250px;
            }
            .stat-box:hover {
                transform: translateY(-5px);
            }
            .stat-box i {
                font-size: 28px;
                margin-bottom: 5px;
                display: block;
            }
            .stat-box a {
                text-decoration: none;
                color: white;
                display: block;
            }
            .stat-box span {
                display: block;
                font-size: 28px;
                font-weight: bold;
                margin-top: 5px;
            }

            /* Section Titles */
            .section-title {
                font-size: 22px;
                font-weight: bold;
                color: #333;
                margin: 20px 0;
                border-left: 4px solid #007bff;
                padding-left: 10px;
                display: flex;
                align-items: center;
            }

            /* Events Table */
            .event-table {
                width: 100%;
                border-collapse: collapse;
                background: white;
                border-radius: 10px;
                overflow: hidden;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
            }
            .event-table th, .event-table td {
                padding: 12px;
                text-align: left;
                font-size: 16px;
            }
            .event-table th {
                background: #007bff;
                color: white;
            }
            .event-table tr:nth-child(even) {
                background: #f2f2f2;
            }
            .event-table tr:hover {
                background: #ddd;
                transition: 0.3s ease-in-out;
            }
        </style>

        <!-- FontAwesome for icons -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"/>
    </template>
</odoo>
