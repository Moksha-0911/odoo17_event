<odoo>
    <template id="dashboard_template">
        <t t-call="web.layout">
            <div class="dashboard-container">

                <h2 class="dashboard-title">📊Event Management Dashboard</h2>
<!--                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>-->
<!--                <div class="chart-container">-->
<!--                    <canvas id="eventLineChart"> </canvas>-->
                <div class="date-filter-section">
                    <div class="date-input-container">
                        <label for="start_date"><strong>Start Date:</strong></label>
                            <input type="date" id="start_date" class="styled-input"/>
                    </div>
                <div class="date-input-container">
                        <label for="end_date"><strong>End Date:</strong></label>
                            <input type="date" id="end_date" class="styled-input"/>
                </div>
                    <button class="filter-btn" onclick="filterEvents()">🎯 Filter Events</button>
                </div>

                <!-- 📊 Statistics Section -->
                <div class="stats-container">
                    <div class="stat-box total-events">
                        <a t-attf-href="/web#action=967"><!--action id for event.management model-->
                            <span class="icon">📅</span>
                            Total Events
                            <span class="count"><t t-esc="total_events"/></span>
                        </a>
                    </div>
                    <div class="stat-box total-attendees">
                        <a t-attf-href="/web#action=969"><!--action id for event.attendee model-->
                            <span class="icon">👥</span>
                            Total Attendees
                            <span class="count"><t t-esc="total_attendees"/></span>
                        </a>
                    </div>
                </div>

                <!-- 📅 Recent Events Section -->
<!--                <img t-att-src="'/Event_management/static/src/img/linechart.png'" string="Linechart" class="dashboard-banner"/>-->
<!--                <img t-att-src="'/Event_management/static/src/img/line.png'" string="Linechart" class="dashboard-banner"/>-->
<!--                <img t-att-src="'/Event_management/static/src/img/barchart.png'" string="Barchart" class="dashboard-banner"/>-->
<!--                <img t-att-src="'/Event_management/static/src/img/piechart.png'" string="Piechart" size="12px" class="dashboard-banner"/>-->

                <h3 class="section-title">📅 Recent Events</h3>
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Date</th>
                            <th>Attendees</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="events" t-as="event"><!--fetches the events from event.management model-->
                            <tr>
                                <td><t t-esc="event['name']"/></td>
                                <td><t t-esc="event['event_date']"/></td>
                                <td><t t-esc="event['attendee_count']"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

