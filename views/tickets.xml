<odoo>
    <data>
        <!-- Form View -->
        <record id="view_event_ticket_form" model="ir.ui.view">
            <field name="name">event.ticket.form</field>
            <field name="model">event.ticket</field>
            <field name="arch" type="xml">
                <form string="Event Ticket">
                    <sheet>
                        <group>
                            <field name="ticket_type_id"/>
                            <field name="event_id" readonly="1"/>
                            <field name="price"/>
                            <field name="available_tickets"/>
<!--                            <field name="currency_id"/>-->
<!--                            <field name="event_price"/>-->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_event_ticket_tree" model="ir.ui.view">
            <field name="name">event.ticket.tree</field>
            <field name="model">event.ticket</field>
            <field name="arch" type="xml">
                <tree string="Event Tickets">
                    <field name="ticket_type_id"/>
                    <field name="event_id" readonly="1"/>
                    <field name="price"/>
                    <field name="available_tickets"/>
<!--                    <field name="currency_id"/>-->
<!--                    <field name="event_price"/>-->
                </tree>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_event_ticket_search" model="ir.ui.view">
            <field name="name">event.ticket.search</field>
            <field name="model">event.ticket</field>
            <field name="arch" type="xml">
                <search string="Search Event Tickets">
                    <field name="event_id" readonly="True"/>
                    <field name="price"/>
                </search>
            </field>
        </record>

    </data>
</odoo>
