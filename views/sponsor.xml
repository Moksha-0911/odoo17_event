<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_event_sponsor_tree" model="ir.ui.view">
        <field name="name">event.sponsor.tree</field>
        <field name="model">event.sponsor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="contribution"/>
                <field name="event_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_event_sponsor_form" model="ir.ui.view">
        <field name="name">event.sponsor.form</field>
        <field name="model">event.sponsor</field>
        <field name="arch" type="xml">
            <form string="Event Sponsor">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="contribution"/>
                        <field name="event_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_event_sponsor_search" model="ir.ui.view">
    <field name="name">event.sponsor.search</field>
    <field name="model">event.sponsor</field>
    <field name="arch" type="xml">
        <search>
            <field name="name"/>
            <field name="contribution"/>
            <field name="event_ids"/>

            <!-- Filters for Sponsored Events -->
            <group string="Event Sponsorship">
                <filter name="filter_sponsored" string="Has Sponsored Event" domain="[('event_ids', '!=', False)]"/>
                <filter name="filter_not_sponsored" string="Not Sponsored Any Event" domain="[('event_ids', '=', False)]"/>
            </group>

            <!-- Group By Options -->
            <separator/>
            <group string="Group By">
                <filter name="group_by_event" string="Event" context="{'group_by': 'event_ids'}"/>
                <filter name="group_by_contribution" string="Contribution" context="{'group_by': 'contribution'}"/>
            </group>
        </search>
    </field>
</record>

</odoo>